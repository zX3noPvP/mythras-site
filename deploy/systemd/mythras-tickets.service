# Ticket bot (ticketbot/bot.py): started by deploy/update.sh when TICKETS_BOT_TOKEN is set in /etc/mythras-site.env
[Unit]
Description=Mythras ticket bot (Discord)
After=network-online.target
Wants=network-online.target

[Service]
User=mythras
Group=mythras
WorkingDirectory=/opt/mythras-site
EnvironmentFile=/etc/mythras-site.env
ExecStart=/opt/mythras-site/.venv/bin/python ticketbot/bot.py
Restart=always
RestartSec=10

# Hardening: like the website, it can only write to the data folder (database + transcript attachments)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mythras-site/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
