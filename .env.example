# Copy to .env for local runs. On the VPS, put these in /etc/mythras-site.env.
# Never commit real values.

# --- Mythras license server (server-side only, never exposed to the browser) ---
# Same VPS as the license server (api-local-only=true, default):
MYTHRAS_API_URL=http://127.0.0.1:8080
# Website on another machine: set api-local-only=false on the license server and use
# MYTHRAS_API_URL=https://license.mythras.eu
MYTHRAS_API_TOKEN=

# --- Admins (comma-separated Discord user IDs) ---
ADMIN_DISCORD_IDS=1102163747524591636

# --- Admin 2FA: encrypts the TOTP secrets in the database ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=

# --- Discord login (Developer Portal -> your application -> OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match one of the Redirects registered on Discord
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback
# Production: https://www.mythras.eu/auth/discord/callback

# --- Website ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 in production (HTTPS): secure cookies, required SECRET_KEY and TOTP_ENC_KEY
COOKIE_SECURE=0
# 1 behind Caddy on the same machine
TRUST_PROXY=0

# Discord server invite (https://discord.gg/...): support, and purchases. The "Buy on Discord" buttons open it:
# customers open a ticket, you take the payment there, then create the key from Admin -> Create license.
SUPPORT_DISCORD_URL=

# Free version download pages (https links, empty = hidden)
FREE_URL_MODRINTH=
FREE_URL_SPIGOT=
FREE_URL_MCMARKET=

# Shown on the Privacy Policy (GDPR art. 13): who runs the site and a contact e-mail
LEGAL_CONTROLLER=
LEGAL_EMAIL=
# Partita IVA / VAT number, shown in the footer and the Terms of Sale when set
LEGAL_VAT=

# Discord webhook (Server settings -> Integrations -> Webhooks) for "site down / back up" alerts (deploy/healthcheck.sh)
MONITOR_DISCORD_WEBHOOK=

# Optional: SQLite file (Discord users + admin 2FA data)
# DATABASE_PATH=
